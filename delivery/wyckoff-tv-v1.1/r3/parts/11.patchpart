@@ -0,0 +1,120 @@
+/* Capability-checked Desktop viewport acquisition, not a Charting Library promise.
+ * Actual series/time/price coordinates are read. Text and manual-object envelopes
+ * are conservative canvas estimates, NEVER labelled native rendered text bounds.
+ * Missing coordinate capabilities fail closed; no guessed screen/price scale.
+ */
+async function gmiViewportV11(req,chart,ms,guard,state,inventory) {
+  const fail=message=>{throw new Error(message);};
+  const number=x=>typeof x==='number'&&Number.isFinite(x);
+  const need=(obj,name)=>{if(typeof obj?.[name]!=='function')fail('VIEWPORT_METHOD_UNAVAILABLE:'+name);};
+  const model=chart._chartWidget?.model?.();
+  const ts=model?.timeScale?.(),ps=ms?.priceScale?.(),bars=ms?.bars?.();
+  for(const n of ['width','indexToCoordinate'])need(ts,n);
+  for(const n of ['height','coordinateToPrice','priceToCoordinate'])need(ps,n);
+  for(const n of ['firstIndex','lastIndex','valueAt'])need(bars,n);
+  need(ms,'firstValue');
+  const base=ms.firstValue();
+  const firstValue=typeof base==='number'?base:base?.value;
+  const width=ts.width(),height=ps.height();
+  if(!number(firstValue)||!number(width)||!number(height)||width<100||height<100||width>20000||height>20000)
+    fail('VIEWPORT_DIMENSIONS_OR_FIRST_VALUE_INVALID');
+  const initial=guard();
+  const end=bars.lastIndex(),start=bars.firstIndex();
+  if(!Number.isInteger(start)||!Number.isInteger(end)||end-start>20000||end<start)fail('VIEWPORT_BAR_LIMIT');
+  const grid={},allGrid={},visible=[];
+  let priorX=null,priorTime=null;
+  for(let i=start;i<=end;i++){
+    const b=bars.valueAt(i);if(!b)continue;
+    const x=ts.indexToCoordinate(i);
+    if(!number(x)||!number(b[0])||!Number.isInteger(b[0]))fail('VIEWPORT_TIME_GRID_INVALID');
+    allGrid[String(b[0])]=x;
+    if(x<0||x>width)continue;
+    if((priorX!==null&&x<=priorX)||(priorTime!==null&&b[0]<=priorTime))fail('VIEWPORT_NONMONOTONIC_TIME_GRID');
+    grid[String(b[0])]=x;priorX=x;priorTime=b[0];visible.push({x,bar:b});
+  }
+  if(visible.length<2)fail('VIEWPORT_TOO_FEW_VISIBLE_BARS');
+  const priceGrid=[];
+  // Direct native inversion samples. This also supports native logarithmic scales
+  // without replacing their transform with an assumed mathematical log formula.
+  for(let y=0;y<=height;y+=height/128){
+    const price=ps.coordinateToPrice(y,firstValue),back=ps.priceToCoordinate(price,firstValue);
+    if(!number(price)||!number(back)||Math.abs(back-y)>0.25)fail('VIEWPORT_PRICE_ROUNDTRIP_FAILED');
+    priceGrid.push([y,price]);
+  }
+  if(priceGrid.some((v,i)=>i&&v[1]>=priceGrid[i-1][1]))fail('INVERTED_OR_NONMONOTONIC_PRICE_SCALE');
+  const layoutItems=req.items;
+  if(!Array.isArray(layoutItems)||layoutItems.length>220)fail('VIEWPORT_ITEM_LIMIT');
+  const family='Arial'; // Explicit estimator family, not an assertion about native font settings.
+  if(document.fonts?.ready)await document.fonts.ready;
+  guard();
+  const context=document.createElement('canvas').getContext('2d');
+  if(!context)fail('CANVAS_TEXT_METRICS_UNAVAILABLE');
+  const measure=(text,size)=>{
+    if(!number(size)||size<10||size>72||typeof text!=='string'||text.length>16000)fail('VIEWPORT_TEXT_METRICS_INVALID');
+    context.font=`${size}px ${family}`;
+    const rows=text.split('\n');
+    const widths=rows.map(line=>context.measureText(line).width);
+    if(widths.some(x=>!number(x)))fail('VIEWPORT_TEXT_WIDTH_INVALID');
+    return [Math.ceil(Math.max(0,...widths)*1.15+16),Math.ceil(rows.length*size*1.45+12)];
+  };
+  const textSizes={};
+  for(const item of layoutItems){
+    if(item.shape==='text'&&!item.retired)textSizes[item.marker]=measure(item.text,item.overrides?.fontsize||14);
+  }
+  const spacing=Math.min(...visible.slice(1).map((v,i)=>v.x-visible[i].x));
+  const obstacles=[];
+  for(const {x,bar} of visible){
+    const top=ps.priceToCoordinate(bar[2],firstValue),bottom=ps.priceToCoordinate(bar[3],firstValue);
+    if(!number(top)||!number(bottom)||top>bottom)fail('VIEWPORT_CANDLE_COORDINATES_INVALID');
+    obstacles.push([x-Math.max(2,spacing*0.38),Math.max(0,top),Math.max(4,spacing*0.76),Math.max(1,Math.min(height,bottom)-Math.max(0,top))]);
+  }
+  // Reserve the bottom band conservatively for possible volume overlay. This is
+  // not a measurement of actual volume pane geometry and remains in the receipt.
+  const reserve=0.28;
+  const workRect=[8,32,width-16,height*(1-reserve)-40];
+  if(workRect[2]<=0||workRect[3]<=0)fail('VIEWPORT_NO_WORK_AREA');
+  const wanted=new Set(layoutItems.map(i=>i.marker));
+  const walkText=obj=>{
+    if(!obj||typeof obj!=='object')return [];
+    return Object.entries(obj).flatMap(([k,v])=>k==='text'&&typeof v==='string'?[v]:walkText(v));
+  };
+  const findSize=obj=>{
+    if(!obj||typeof obj!=='object')return null;
+    for(const [k,v] of Object.entries(obj)){if(k==='fontsize'&&number(v))return v;const n=findSize(v);if(n!==null)return n;}
+    return null;
+  };
+  const manualUnresolved=[];
+  for(const shape of inventory()){
+    if(shape.unreadable){manualUnresolved.push(shape.id);continue;}
