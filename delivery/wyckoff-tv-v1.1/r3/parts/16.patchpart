+
+UTC=timezone.utc
+AT='2026-10-09T12:02:00+00:00'
+
+
+def capture_frame(tf, at=AT, count=2000):
+    stamp=datetime.fromisoformat(at)
+    start=datetime(2024,1,1,tzinfo=UTC)
+    rows=[]
+    while start<=stamp:
+        opened,closed,_=utc_interval(start,tf)
+        rows.append({'time':int(opened.timestamp()),'open':100.,'high':112.,'low':98.,'close':100.,
+                     'volume':(closed-opened).total_seconds()/86400*1000})
+        start=closed
+    return {'origin':'TV_NATIVE_CDP','captured_at':at,'timeframe':tf,
+            'state':{'symbol':'SYNTH:UNIT','resolution':RESOLUTIONS[tf],'chart_type':1,
+                     'layout_id':'SYNTH_LAYOUT','info':{'name':'UNIT','volume_type':'base'},'ext':{}},
+            'bars':rows[-count:]}
+
+
