+class MultiProductPipeline(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup);self.ws=Path(self.tmp.name)
+        self.c=template();self.c.update(enabled=True,write_tv=False,review_model='SYNTHETIC',min_monthly_bars=2,min_weekly_bars=2,min_daily_bars=2,min_4h_bars=2)
+        for name,asset in [('ONE','BTC'),('TWO','GOLD')]:
+            p=product();p['symbol']='SYNTH:'+name;p['layout_id']='TEST_'+name;p['asset_key']=asset
+            p['instrument'].update(product_id=p['symbol'],provider_symbol=p['symbol'],underlying_id=asset)
+            p.update(analysis_timeframes=['1M','1W','1D','4H'],layout_mode='SEQUENTIAL_SAME_PRODUCT')
+            self.c['products'].append(p)
+        self.seen=[];self.fail_first=False;outer=self
+        class Engine:
+            code_hash='SYNTHETIC_ONLY'
+            def compute(self,ds,root):return computed(ds)
+        class Review(CodexReviewer):
+            def __init__(self):super().__init__(model='SYNTHETIC')
+            def _execute(self,p,r,schema,prompt):
+                outer.seen.append(((p.get('primary') or p['daily'])['instrument']['provider_symbol'],p['primary_timeframe']));return answer(p),{'origin':'SYNTHETIC'}
+        class Chart:
+            def connect(self):return self
+            def close(self):pass
+            def capture(self,symbol,tf,**kw):
+                if outer.fail_first and symbol=='SYNTH:ONE':raise NativeError('SYNTHETIC_FEED_DOWN')
+                c=capture_frame(tf,count=kw['count']);c['state']['symbol']=symbol;return c
+        self.eng=Engine();self.rev=Review();self.factory=lambda p:Chart()
+    def runone(self):return run_once(self.ws,self.c,engine=self.eng,reviewer=self.rev,tv_factory=self.factory,clock=lambda:AT)
+    def test_eight_research_tracks_not_one_asset_cache(self):
+        r=self.runone();self.assertEqual(r['state'],'COMPLETED',r);self.assertEqual(len(set(self.seen)),8)
+        st=EventStore(self.ws/'archive');recs=[e for e in st.events() if e['kind']=='TV11_MAIN_RECORD'];self.assertEqual(len(recs),8)
+        self.assertEqual(len(set(e['payload']['track_id'] for e in recs)),8)
+    def test_feed_failure_does_not_stop_other_asset(self):
+        self.fail_first=True;r=self.runone();self.assertEqual(r['state'],'PARTIAL',r)
+        self.assertEqual({s for s,t in self.seen},{'SYNTH:TWO'});self.assertEqual(len(self.seen),4)
+
