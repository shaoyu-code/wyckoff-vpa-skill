 def marker(product_id: str,key: str):return '[GMI:'+digest([product_id,key])[:24]+']'
+
+
+def readable_lines(text: str, width: int=32) -> str:
+    """Add whitespace only; do not truncate the reason or split numeric tokens."""
+    output=[]
+    for line in str(text).split('\n'):
+        if line.startswith('[GMI:'):output.append(line);continue
+        current=''
+        for token in re.findall(r'[-+]?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?|[A-Za-z_][A-Za-z0-9_:./-]*|.',line):
+            if current and len(current)+len(token)>width:
+                output.append(current);current=''
+            current+=token
+        output.append(current)
+    return '\n'.join(output)
 
 
