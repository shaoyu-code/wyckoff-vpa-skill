+def interpolate(value, pairs):
+    from bisect import bisect_left
+    xs=[p[0] for p in pairs]
+    if not xs[0]<=value<=xs[-1]:raise NativeError('PRICE_OUTSIDE_MEASURED_VIEWPORT')
+    i=bisect_left(xs,value)
+    if i<len(pairs) and xs[i]==value:return pairs[i][1]
+    a,b=pairs[i-1],pairs[i]
+    return a[1]+(value-a[0])/(b[0]-a[0])*(b[1]-a[1])
 
 
