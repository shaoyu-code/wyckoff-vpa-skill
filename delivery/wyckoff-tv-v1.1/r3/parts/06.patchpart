+    if not result.resolve().is_relative_to(root.resolve()):raise NativeError('VAULT_PATH_ESCAPE')
+    return result
+
+
+def _open_note_parent(path: Path):
+    # Walk directory descriptors without following a replaced intermediate link.
+    # Paths from sync_vault use the resolved, explicitly configured Vault root.
+    path=path.absolute()
+    if '..' in path.parts:raise NativeError('VAULT_PATH_ESCAPE')
+    flags=os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW
+    fd=os.open(path.anchor,flags)
+    try:
+        for part in path.parts[1:]:
+            try:os.mkdir(part,mode=0o700,dir_fd=fd)
+            except FileExistsError:pass
+            child=os.open(part,flags,dir_fd=fd)
+            os.close(fd);fd=child
+        return fd
+    except BaseException:
+        os.close(fd);raise
+
+
+def _new_file(path: Path,data: bytes):
+    if not isinstance(data,bytes):raise TypeError('note content must be bytes')
+    parent=_open_note_parent(path.parent);temporary=None
+    def matches_existing():
+        try:fd=os.open(path.name,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=parent)
+        except FileNotFoundError:return False
+        with os.fdopen(fd,'rb') as stream:
+            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode) or stream.read(len(data)+1)!=data:
+                raise NativeError('HUMAN_NOTE_CONFLICT:'+path.name)
+        return True
+    try:
+        if matches_existing():return
+        temporary='.gmi-note-'+secrets.token_hex(12)
+        fd=os.open(temporary,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=parent)
+        with os.fdopen(fd,'wb') as f:f.write(data);f.flush();os.fsync(f.fileno())
+        try:os.link(temporary,path.name,src_dir_fd=parent,dst_dir_fd=parent,follow_symlinks=False)
+        except FileExistsError:
+            if not matches_existing():raise NativeError('VAULT_NOTE_DISAPPEARED_DURING_PUBLICATION')
+        os.fsync(parent)
+        if not matches_existing():raise NativeError('VAULT_NOTE_READBACK_FAILED')
+    finally:
+        if temporary:
+            try:os.unlink(temporary,dir_fd=parent)
+            except FileNotFoundError:pass
+        os.close(parent)
+
+
+def sync_vault(store,config: dict,*,as_of: str) -> dict:
+    cfg=validate_journal_config(config)
+    if not cfg['enabled']:return {'status':'DISABLED','verified_notes':0}
+    if not cfg['vault_path'] or not cfg['timezone']:return {'status':'CONFIGURATION_PENDING','verified_notes':0}
+    vault=Path(cfg['vault_path']).expanduser().resolve(strict=True)
+    if not vault.is_dir():raise NativeError('VAULT_NOT_DIRECTORY')
+    root=_safe_path(vault,cfg['folder']);owner=_safe_path(root,'.gmi-owner.json')
+    expected=canonical({'kind':'GMI_OWNED_JOURNAL','version':1,'archive':digest(str(store.root))})
+    if root.exists() and not owner.exists() and any(root.iterdir()):raise NativeError('UNOWNED_JOURNAL_FOLDER')
+    _new_file(owner,expected)
+    events=_record_events(store,as_of);files={};latest={};errors=[]
+    for event in events:
+        key=event['snapshot_sha256'];body=store.read_snapshot(key)
+        if body.get('lineage_scope')!='MAIN_ONLY' or body.get('contains_sidecar_targets') is not False:
+            raise NativeError('VAULT_MAIN_LINEAGE_CONFLICT')
+        if event['kind']=='TV11_MAIN_RECORD':
+            date=timestamp(body['recorded_at']).astimezone(ZoneInfo(cfg['timezone'])).date().isoformat()
+            relative=f"daily/{date}/{digest(body['track_id'])[:16]}-{key[:16]}.md"
+            text=render_record(body,key);latest[body['track_id']]=(body,relative)
+        elif event['kind']=='TV11_CALENDAR_REVIEW':
+            relative=f"reviews/{body['period']['kind'].lower()}/{body['period']['id']}-{key[:16]}.md"
+            text=render_review(body,key,store)
+        else:
+            relative=f"checks/{body['day']}-{key[:16]}.md"
+            text=render_daily_check(body,key)
+        raw=text.encode('utf-8')
+        try:_new_file(_safe_path(root,relative),raw);files[relative]=hashlib.sha256(raw).hexdigest()
+        except (OSError,NativeError) as exc:errors.append(str(exc))
+    index='# 当前研究索引\n\n这里只链接当时原记录；新判断不会覆盖旧文件。\n\n'+''.join(
+        f"{b['product_id']} / {b['timeframe']} · 量价截至 {b['data_cutoff']} · [当时判断](../{path})\n\n"
+        for _,(b,path) in sorted(latest.items()))
+    # Index editions are also immutable. No mutable user note is ever overwritten.
+    index_path='indexes/current-'+hashlib.sha256(index.encode()).hexdigest()[:20]+'.md'
+    if not errors:_new_file(_safe_path(root,index_path),index.encode('utf-8'))
+    result={'status':'PARTIAL' if errors else 'SYNCED','verified_notes':len(files),'files':files,
+            'errors':errors,'index':None if errors else index_path,'root_identity':digest(str(root))}
+    key=digest(result)
+    if not any(e['kind']=='TV11_VAULT_SYNC' and e['payload']==result for e in store.events()):
+        store.append('TV11_VAULT_SYNC','tv11-vault:'+digest(str(root)),result,at=as_of,
+                     idempotency_key='tv11-vault:'+key,snapshot_sha256=store.snapshot(result))
+    return result
+
+
+def journal_checkpoint(store,config: dict,*,as_of: str,invocation: dict | None=None) -> dict:
+    cfg=validate_journal_config(config.get('journal'))
+    if not cfg['enabled']:return {'status':'DISABLED','reviews_created':0}
+    if not cfg['timezone']:return {'status':'CONFIGURATION_PENDING','reviews_created':0}
+    try:
+        if invocation is not None:record_daily_check(store,invocation,as_of=as_of,zone=cfg['timezone'])
+        created=create_calendar_reviews(store,as_of=as_of,zone=cfg['timezone'])
+        result=sync_vault(store,cfg,as_of=as_of)
+        return {**result,'reviews_created':len(created),'calendar_rule':'SUNDAY_AND_NEXT_MONTH_DAY_1',
+                'scheduler_created':False}
+    except (OSError,ValueError,NativeError) as exc:
+        return {'status':'FAILED','error':str(exc),'scheduler_created':False}
