+def bar_trading_seconds(bar: dict, instrument) -> float:
+    """Actual open-session overlap; do not call a month of nights trading time.
+
+    The source qualifier separately verifies this calendar and its version. This
+    function intersects actual opens/closes and removes lunch breaks. Calendar
+    failures propagate rather than silently substituting calendar duration.
+    """
+    from datetime import timedelta
+    from ...market_integrity import exchange_calendar
+    opened, closed=instant(bar['opened_at']), instant(bar['closed_at'])
+    if instrument.calendar_id=='24/7_UTC':
+        if instrument.calendar_version!='24/7_UTC-v1':
+            raise NativeError('WAVE_CALENDAR_VERSION_MISMATCH')
+        return (closed-opened).total_seconds()
+    import exchange_calendars
+    import pandas as pd
+    if instrument.calendar_version!='exchange_calendars:'+exchange_calendars.__version__:
+        raise NativeError('WAVE_CALENDAR_VERSION_MISMATCH')
+    cal=exchange_calendar(instrument.calendar_id,opened.year)
+    days=cal.sessions_in_range((opened.date()-timedelta(days=2)).isoformat(),
+                              (closed.date()+timedelta(days=2)).isoformat())
+    seconds=[]
+    for day in days:
+        op=cal.session_open(day).to_pydatetime();cl=cal.session_close(day).to_pydatetime()
+        left,right=max(opened,op),min(closed,cl)
+        if left>=right:continue
+        span=(right-left).total_seconds()
+        pause=cal.session_break_start(day);resume=cal.session_break_end(day)
+        if not pd.isna(pause) and not pd.isna(resume):
+            begin=max(left,pause.to_pydatetime());end=min(right,resume.to_pydatetime())
+            span-=max(0,(end-begin).total_seconds())
+        seconds.append(span)
+    result=math.fsum(seconds)
+    if result<=0:raise NativeError('WAVE_NO_VERIFIED_TRADING_TIME')
+    return result
+
+
