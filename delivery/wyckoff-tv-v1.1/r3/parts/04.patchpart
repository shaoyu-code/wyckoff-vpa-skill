@@ -0,0 +1,376 @@
+"""Main-only immutable research journal and calendar review publishing.
+
+No scheduler is installed. Called by the existing runner (including IDLE) or the
+explicit `journal` command. A configured timezone determines calendar periods;
+unknown timezone/Vault path is not silently replaced. No notes outside the owned
+subdirectory are read or changed. This is evidence rendering, not a market model.
+"""
+from __future__ import annotations
+from copy import deepcopy
+from datetime import datetime, timedelta, timezone
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import secrets
+import stat
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+from ..contracts import canonical, digest
+from ...market_integrity import timestamp
+from .tradingview import NativeError
+from .evidence_v11 import audit_window
+
+VERSION='tv11-journal-2'
+KINDS={'TV11_MAIN_RECORD','TV11_CALENDAR_REVIEW','TV11_DAILY_CHECK'}
+
+
+def validate_journal_config(config: dict | None) -> dict:
+    if config is None:return {'enabled':False,'timezone':None,'vault_path':None,'folder':'Wyckoff'}
+    if not isinstance(config,dict) or set(config)-{'enabled','timezone','vault_path','folder'}:
+        raise ValueError('JOURNAL_CONFIG_KEYS_INVALID')
+    if type(config.get('enabled')) is not bool:raise ValueError('JOURNAL_ENABLED_BOOLEAN_REQUIRED')
+    zone=config.get('timezone')
+    if zone is not None:
+        if not isinstance(zone,str):raise ValueError('JOURNAL_TIMEZONE_INVALID')
+        try:ZoneInfo(zone)
+        except (ZoneInfoNotFoundError,ValueError) as exc:raise ValueError('JOURNAL_TIMEZONE_INVALID') from exc
+    folder=config.get('folder','Wyckoff')
+    if not isinstance(folder,str):raise ValueError('JOURNAL_FOLDER_INVALID')
+    parts=PurePosixPath(folder)
+    if not folder or parts.is_absolute() or '..' in parts.parts or '\\' in folder or str(parts)!=folder:
+        raise ValueError('JOURNAL_FOLDER_INVALID')
+    vault=config.get('vault_path')
+    if vault is not None and (not isinstance(vault,str) or not Path(vault).expanduser().is_absolute()):
+        raise ValueError('JOURNAL_VAULT_MUST_BE_EXPLICIT_ABSOLUTE_PATH')
+    return {'enabled':config['enabled'],'timezone':zone,'vault_path':vault,'folder':folder}
+
+
+def _record_events(store,as_of):
+    return [e for e in store.events() if e['kind'] in KINDS
+            and timestamp(e['recorded_at'])<=timestamp(as_of)]
+
+
+def freeze_main_record(store,dataset: dict,review: dict,*,at: str,model_version: str,track_id: str) -> dict:
+    """Every valid read, including no opportunity, keeps its actual first record time."""
+    audit=audit_window(dataset)
+    known=max(timestamp(dataset.get('captured_at',at)),timestamp(dataset.get('qualification_as_of',at)))
+    if known>timestamp(at):raise NativeError('JOURNAL_FUTURE_INPUT')
+    source_key=digest({'dataset':dataset,'review':review,'model':model_version,'track_id':track_id,'version':VERSION})
+    for event in reversed(_record_events(store,at)):
+        if event['kind']=='TV11_MAIN_RECORD' and event['payload']['source_fingerprint']==source_key:
+            return store.read_snapshot(event['snapshot_sha256'])
+    body={'schema_version':'gmi-tv11-main-record-v1','record_type':'MAIN_RESEARCH','lineage_scope':'MAIN_ONLY',
+          'contains_sidecar_targets':False,'version':VERSION,'track_id':track_id,
+          'product_id':dataset['instrument']['product_id'],'timeframe':dataset['timeframe'],
+          'recorded_at':at,'data_cutoff':dataset['bars'][-1]['closed_at'],
+          'source_fingerprint':source_key,'dataset_sha256':store.snapshot(dataset),
+          'window_audit':audit,'review':deepcopy(review),'model_version':model_version,
+          'tv_status_at_freeze':'NOT_YET_DELIVERED','probability_status':'NO_CALIBRATED_PROBABILITY',
+          'method_coverage':review.get('method_coverage','SCOPE_NOT_VERIFIED')}
