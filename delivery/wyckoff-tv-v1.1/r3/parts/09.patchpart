+++ b/src/global_market_intelligence/opportunities/native/scope_v11.py
@@ -0,0 +1,37 @@
+"""Declared asset coverage, not guessed tickers or an approval certificate."""
+from ..contracts import Instrument
+from ..timeframes import selected_frames, tracks
+
+REQUESTED_ASSETS=('BTC','ETH','SOL','BNB','GOLD','SILVER','CRUDE_OIL')
+
+
+def scope_report(config: dict) -> dict:
+    """Only explicit asset keys/underlying IDs bind an instrument to user scope.
+
+    A future contract is not substituted for spot, a different venue, or another
+    oil grade. Multiple verified product identities can belong to one asset.
+    This function is read-only and has no network or UI operations.
+    """
+    products=[]
+    by_asset={key:[] for key in REQUESTED_ASSETS}
+    for p in config.get('products',[]):
+        inst=Instrument(**p['instrument'])
+        key=p.get('asset_key') or (inst.underlying_id if inst.underlying_id in REQUESTED_ASSETS else None)
+        entry={'instrument_id':inst.identity,'symbol':p['symbol'],'asset_key':key,
+               'underlying_id':inst.underlying_id,'instrument_type':inst.instrument_type,
+               'contract_month':inst.contract_month,'price_basis_id':inst.price_basis_id,
+               'calendar_id':inst.calendar_id,'volume_basis':p['profile'].get('volume_basis','UNKNOWN'),
+               'research_timeframes':selected_frames(p),
+               'delivery_bound_timeframes':[t['analysis_timeframe'] for t in tracks(p) if t.get('layout_id')],
+               'qualification':'CONFIGURATION_ONLY_NOT_MARKET_OR_TV_ACCEPTANCE'}
+        products.append(entry)
+        if key in by_asset:by_asset[key].append(inst.identity)
