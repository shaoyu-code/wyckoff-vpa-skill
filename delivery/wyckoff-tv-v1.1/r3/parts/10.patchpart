+    def prepare_manifest(self, manifest: dict, dataset: dict) -> dict:
+        """Read actual native viewport, then freeze its target and layout in plan.
+
+        Coordinate capture is real native data, font boxes remain explicitly
+        conservative estimates. No production visual approval is synthesized.
+        """
+        from .layout_v11 import arrange_labels
+        capture=dataset.get('native_capture',{}).get('state',{})
+        before=self._request('state')
+        expected=target_witness(capture)
+        assert_target(before,expected,allow_resolution_change=True)
+        if before['symbol']!=manifest['symbol'] or before['layout_id']!=manifest['layout_id']:
+            raise NativeError('PREPARE_WRONG_NATIVE_TARGET')
+        self._guard_witness=None
+        selected=self.select(manifest['symbol'],manifest['timeframe'],expected_target=target_witness(before))
+        # Programmatic cycle selection is intended; any user input during it is not.
+        if selected['interaction_epoch']!=before['interaction_epoch']:
+            raise NativeError('USER_INTERVENED_DURING_PREPARE')
+        self._guard_witness=target_witness(selected)
+        measured=self._request('viewport',product_id=manifest['product_id'],timeframe=manifest['timeframe'],
+                               data_cutoff=manifest['data_cutoff'],items=manifest['items'])
+        assert_target(measured['state'],self._guard_witness)
+        view=measured['view'];view['id']=digest({k:v for k,v in view.items() if k!='captured_epoch'})
+        result=arrange_labels(manifest,view)
+        result['viewport_evidence']=view
+        result['target_witness']=deepcopy(self._guard_witness)
+        result['target_guard_scope']='PER_ACTION_CONTEXT_GUARD_ASYNC_NATIVE_SEMANTICS_REQUIRES_LOCAL_ACCEPTANCE'
+        return result
+
+    def _check_target(self):
+        if self._guard_witness is not None:
+            assert_target(self._request('state'),self._guard_witness)
+
