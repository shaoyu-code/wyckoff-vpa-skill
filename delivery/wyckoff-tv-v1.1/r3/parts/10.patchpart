+ALIASES={'M':'1M','W':'1W','D':'1D','1M':'1M','1W':'1W','1D':'1D','720':'720','240':'240','60':'60'}
 
 class NativeError(RuntimeError):
     pass
+
+
+TARGET_KEYS=('layout_id','symbol','resolution','chart_type','document_epoch','chart_instance','series_instance','interaction_epoch')
+CONTEXT_FIELDS={'ext':('symbol','exchange','type','session','adjustment','backadjustment','currencyCode','currency_code','settlement_as_close'),
+                'info':('ticker','pro_name','full_name','name','type','session','timezone','currency_code','volume_type','pricescale','minmov')}
+
+
+def target_witness(state: dict) -> dict:
+    if state.get('guard_version')!='tv11-context-2' or any(k not in state or state[k] is None for k in TARGET_KEYS):
+        raise NativeError('STABLE_NATIVE_TARGET_WITNESS_REQUIRED')
+    if type(state['interaction_epoch']) is not int or state['interaction_epoch']<0:
+        raise NativeError('NATIVE_INTERACTION_GENERATION_INVALID')
+    return {**{k:deepcopy(state[k]) for k in TARGET_KEYS},
+            **{section:{k:deepcopy(state.get(section,{}).get(k)) for k in keys if k in state.get(section,{})}
+               for section,keys in CONTEXT_FIELDS.items()}}
+
+
+def assert_target(actual: dict, expected: dict, *, allow_resolution_change=False):
+    value=target_witness(actual)
+    for k in TARGET_KEYS:
+        if allow_resolution_change and k in {'resolution','series_instance'}:continue
+        if value[k]!=expected[k]:raise NativeError('TV_TARGET_CHANGED:'+k)
+    for section in CONTEXT_FIELDS:
+        if value[section]!=expected[section]:raise NativeError('TV_TARGET_MODIFIERS_CHANGED:'+section)
+    return value
+
+
+def assert_interaction_continuity(before: dict, actual: dict):
+    """Selection may change the series, never the user's pane or interaction epoch."""
+    if before.get('guard_version')!='tv11-context-2':return  # legacy read-only fixtures
+    old=target_witness(before);new=target_witness(actual)
+    for key in ('layout_id','chart_instance','document_epoch','interaction_epoch','chart_type'):
+        if old[key]!=new[key]:raise NativeError('USER_INTERVENED_NO_FORCE_RESTORE:'+key)
 
 
 def local_endpoint(value: str) -> str:
