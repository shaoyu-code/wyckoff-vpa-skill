+// Synthetic chart adapter tests. This runs the real native wrapper in a VM, not TV.
+const assert=require('node:assert/strict');
+const fs=require('node:fs');const vm=require('node:vm');const path=require('node:path');
+const source=path.join(__dirname,'../src/global_market_intelligence/opportunities/native');
+const js=fs.readFileSync(path.join(source,'viewport_v11.js'),'utf8')+'\n'+fs.readFileSync(path.join(source,'tv_native.js'),'utf8');
+function fixture(){
+ const env={symbol:'SYNTH:UNIT',res:'240',shapes:[],writes:0,modifyHook:null,fontHook:null,scale:1};
+ const bars=Array.from({length:20},(_,i)=>[1000+i*14400,100,105,95,101,1000]);
+ const ps={height:()=>600,coordinateToPrice:y=>120-y/15,priceToCoordinate:p=>(120-p)*15};
+ const ts={width:()=>1000,indexToCoordinate:i=>50+i*45};
+ const ms={symbolInfo:()=>({name:'UNIT',volume_type:'base',session:'24x7'}),bars:()=>({firstIndex:()=>0,lastIndex:()=>bars.length-1,valueAt:i=>bars[i]}),priceScale:()=>ps,firstValue:()=>({value:100})};
+ const model={mainSeries:()=>ms,timeScale:()=>ts};
+ const shapeObj=id=>({getPoints:()=>env.shapes.find(s=>s.id===id).points,getProperties:()=>env.shapes.find(s=>s.id===id).properties,
+  setPoints:async p=>{env.shapes.find(s=>s.id===id).points=JSON.parse(JSON.stringify(p));if(env.modifyHook)env.modifyHook();},
+  setProperties:async p=>{env.writes++;env.shapes.find(s=>s.id===id).properties=p;}});
+ const chart={_chartWidget:{model:()=>model},symbol:()=>env.symbol,resolution:()=>env.res,chartType:()=>1,
+  symbolExt:()=>({symbol:env.symbol,backadjustment:env.scale}),
+  getAllShapes:()=>env.shapes.map(s=>({id:s.id,name:s.name})),getShapeById:shapeObj,
+  createShape:(point,opts)=>{env.writes++;env.shapes.push({id:'new'+env.writes,name:opts.shape,points:[point],properties:opts.overrides});return Promise.resolve('new'+env.writes);},
+  createMultipointShape:()=>{env.writes++;return 'multi';},removeEntity:id=>{env.writes++;env.shapes=env.shapes.filter(s=>s.id!==id);},
+  setSymbol:async v=>{env.symbol=v;},setResolution:async v=>{env.res=v;}};
+ const listeners={};const root={_activeChartWidgetWV:{value:()=>env.active||chart}};
+ const context={window:{TradingViewApi:root,devicePixelRatio:2},document:{readyState:'complete',
+  addEventListener:(n,f)=>{listeners[n]=f;},querySelector:()=>null,
+  fonts:{get ready(){return Promise.resolve().then(()=>env.fontHook&&env.fontHook());}},
+  createElement:()=>({getContext:()=>({font:'',measureText:t=>({width:t.length*9})})})},
+  location:{pathname:'/chart/LAYOUT/',origin:'https://www.tradingview.com'},performance:{timeOrigin:123456},setTimeout,clearTimeout,console};
+ vm.createContext(context);vm.runInContext(js,context);
+ env.call=async req=>JSON.parse(JSON.stringify(await context.gmiNative(req)));
+ env.chart=chart;env.ms=ms;env.ps=ps;env.ts=ts;env.interact=()=>listeners.pointerdown({isTrusted:true});
+ env.item={marker:'[GMI:test]',shape:'text',points:[{time:1000+10*14400,price:105}],text:'4H 当前结构\n[GMI:test]',overrides:{fontsize:14}};
+ env.witness=async()=>env.call({action:'state'});
+ return env;
+}
+const tests=[];const test=(name,fn)=>tests.push([name,fn]);
+test('viewport reads native transforms and actual time grid',async()=>{
+ const e=fixture(),w=await e.witness();const r=await e.call({action:'viewport',expected_target:w,items:[e.item],product_id:'SYNTH',timeframe:'4H',data_cutoff:'2026-01-01'});
+ assert.equal(r.view.time_x[String(1000+10*14400)],500);assert.equal(r.view.price_grid[0][1],120);
+ assert.equal(r.view.price_low,80);assert.equal(r.view.bbox_basis,'CANVAS_CONSERVATIVE_ESTIMATE');assert.equal(e.writes,0);
+});
+test('symbol changed after witness means zero write',async()=>{const e=fixture(),w=await e.witness();e.symbol='SYNTH:OTHER';await assert.rejects(e.call({action:'create',expected_target:w,item:e.item}),/TARGET_CHANGED:symbol/);assert.equal(e.writes,0);});
+test('pane changed means zero write',async()=>{const e=fixture(),w=await e.witness();e.active={...e.chart};await assert.rejects(e.call({action:'create',expected_target:w,item:e.item}),/TARGET_CHANGED:chart_instance/);assert.equal(e.writes,0);});
+test('same symbol after manual round trip remains stale',async()=>{const e=fixture(),w=await e.witness();e.interact();await assert.rejects(e.call({action:'create',expected_target:w,item:e.item}),/interaction_epoch/);assert.equal(e.writes,0);});
+test('price modifiers cannot change unnoticed',async()=>{const e=fixture(),w=await e.witness();e.scale=2;await assert.rejects(e.call({action:'create',expected_target:w,item:e.item}),/MODIFIER_CHANGED/);assert.equal(e.writes,0);});
+test('resolution changed means zero write',async()=>{const e=fixture(),w=await e.witness();e.res='1D';await assert.rejects(e.call({action:'create',expected_target:w,item:e.item}),/resolution/);assert.equal(e.writes,0);});
+test('unchanged target can create a native-shaped object',async()=>{const e=fixture(),w=await e.witness();await e.call({action:'create',expected_target:w,item:e.item});assert.equal(e.writes,1);});
+test('user edit between setters is preserved',async()=>{
+ const e=fixture();e.shapes=[{id:'a',name:'text',points:[{time:1000,price:100}],properties:{text:'[GMI:test] old'}}];
+ const expected=JSON.parse(JSON.stringify(e.shapes[0])),w=await e.witness();e.modifyHook=()=>{e.shapes[0].properties.text='Human takes ownership';};
+ await assert.rejects(e.call({action:'modify',expected_target:w,entity_id:'a',marker:'[GMI:test]',expected,item:e.item}),/MANUAL_EDIT_BETWEEN/);
+ assert.equal(e.shapes[0].properties.text,'Human takes ownership');assert.equal(e.writes,0);
+});
+test('user switch between setters stops second mutation',async()=>{
+ const e=fixture();e.shapes=[{id:'a',name:'text',points:[{time:1000,price:100}],properties:{text:'[GMI:test] old'}}];
+ const expected=JSON.parse(JSON.stringify(e.shapes[0])),w=await e.witness();e.modifyHook=()=>{e.res='1D';};
+ await assert.rejects(e.call({action:'modify',expected_target:w,entity_id:'a',marker:'[GMI:test]',expected,item:e.item}),/resolution/);assert.equal(e.writes,0);
+});
+test('missing native inverse transform does not guess a scale',async()=>{const e=fixture();delete e.ps.coordinateToPrice;await assert.rejects(e.call({action:'viewport',items:[e.item]}),/METHOD_UNAVAILABLE/);assert.equal(e.writes,0);});
+test('bad native round trip is rejected',async()=>{const e=fixture();e.ps.priceToCoordinate=()=>42;await assert.rejects(e.call({action:'viewport',items:[e.item]}),/ROUNDTRIP/);});
+test('font await preserves target protection',async()=>{const e=fixture(),w=await e.witness();e.fontHook=()=>e.interact();await assert.rejects(e.call({action:'viewport',expected_target:w,items:[e.item]}),/interaction_epoch/);assert.equal(e.writes,0);});
+test('unresolved manual shapes are reported not hidden',async()=>{const e=fixture();e.shapes.push({id:'manual',name:'unknown',points:[],properties:{text:'keep'}});const r=await e.call({action:'viewport',items:[e.item]});assert.deepEqual(r.view.manual_bounds_unresolved,['manual']);assert.equal(e.shapes.length,1);});
+test('offscreen manual text with known time coordinates remains bounded',async()=>{const e=fixture();e.ts.indexToCoordinate=i=>-300+i*65;e.shapes.push({id:'manual',name:'text',points:[{time:1000,price:100}],properties:{text:'old'}});const r=await e.call({action:'viewport',items:[e.item]});assert.deepEqual(r.view.manual_bounds_unresolved,[]);});
+test('inverted scales remain unsupported not silently flipped',async()=>{const e=fixture();e.ps.coordinateToPrice=y=>y;e.ps.priceToCoordinate=p=>p;await assert.rejects(e.call({action:'viewport',items:[e.item]}),/INVERTED/);});
+(async()=>{
+ const failures=[];for(const [name,fn] of tests){try{await fn();console.log('PASS '+name);}catch(e){failures.push({name,error:String(e.stack)});console.error('FAIL '+name+' '+e.stack);}}
+ console.log(JSON.stringify({scope:'SYNTHETIC_NODE_VM_NOT_TRADINGVIEW',tests:tests.length,passed:tests.length-failures.length,failed:failures.length}));
+ if(failures.length)process.exitCode=1;
+})();
