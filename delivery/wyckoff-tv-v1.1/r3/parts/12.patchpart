+    const text=walkText(shape.properties).join('\n');
+    // Only exact plan-owned objects are omitted. Other [GMI:] objects are not
+    // automatically owned and must remain obstacles until reconciliation.
+    if([...wanted].some(tag=>text.includes(tag)))continue;
+    const points=shape.points||[],mapped=points.map(p=>[allGrid[String(p.time)],ps.priceToCoordinate(p.price,firstValue)]);
+    if(!points.length){manualUnresolved.push(shape.id);continue;}
+    if(mapped.every(p=>p[0]===undefined)){
+      // Rays and lines can cross the viewport even when both anchors are offscreen.
+      manualUnresolved.push(shape.id);continue;
+    }
+    if(mapped.some(p=>!number(p[0])||!number(p[1]))){manualUnresolved.push(shape.id);continue;}
+    if(points.length===1&&String(shape.name).toLowerCase().includes('text')){
+      const [w,h]=measure(text,findSize(shape.properties)||14);
+      // Enclose either left/right and top/bottom anchor convention for manual text.
+      obstacles.push([mapped[0][0]-w,mapped[0][1]-h,2*w,2*h]);
+    }else if(points.length>=2){
+      const xs=mapped.map(p=>p[0]),ys=mapped.map(p=>p[1]);
+      obstacles.push([Math.min(...xs)-4,Math.min(...ys)-4,Math.max(...xs)-Math.min(...xs)+8,Math.max(...ys)-Math.min(...ys)+8]);
+    }else {manualUnresolved.push(shape.id);}
+  }
+  const final=guard();
+  if(initial.chart_instance!==final.chart_instance||initial.document_epoch!==final.document_epoch||initial.interaction_epoch!==final.interaction_epoch)
+    fail('VIEWPORT_CONTEXT_CHANGED_DURING_MEASURE');
+  return {state:final,view:{product_id:req.product_id,timeframe:req.timeframe,data_cutoff:req.data_cutoff,
+    time_x:grid,price_grid:priceGrid,price_low:priceGrid.at(-1)[1],price_high:priceGrid[0][1],
+    price_y_top:0,price_y_bottom:height,scale:'native_samples',work_rect:workRect,obstacles,text_sizes:textSizes,
+    bbox_basis:'CANVAS_CONSERVATIVE_ESTIMATE',font_estimator:family,volume_reserved_fraction:reserve,
+    manual_bounds_unresolved:manualUnresolved,coordinate_basis:'ACTUAL_NATIVE_SERIES_AND_SCALES',
+    text_anchor_basis:'TOP_LEFT_ASSUMPTION_REQUIRES_NATIVE_ACCEPTANCE',
+    acquisition_status:'MEASURED_COORDINATES_ESTIMATED_TEXT_NOT_VISUAL_ACCEPTANCE',
+    device_pixel_ratio:window.devicePixelRatio||1,viewport_css:{width,height},captured_epoch:Date.now()}};
+}
