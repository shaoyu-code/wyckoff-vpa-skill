--- /dev/null
+++ b/src/global_market_intelligence/opportunities/periods_v11.py
@@ -0,0 +1,117 @@
+"""Calendar periods, not nominal 30-day months or partial-week finalization.
+
+This is interval plumbing, not a Wyckoff rule. The caller supplies the exact
+exchange calendar and chart timestamp convention; no product proxy is inferred.
+"""
+from __future__ import annotations
+from datetime import date, datetime, timedelta, timezone
+from ..market_integrity import exchange_calendar
+
+UTC = timezone.utc
+HOURS = {'1H': 1, '4H': 4, '12H': 12, '1D': 24, '1W': 168}
+
+
+def next_month(day: date) -> date:
+    return date(day.year + (day.month == 12), 1 if day.month == 12 else day.month + 1, 1)
+
+
+def period_dates(day: date, timeframe: str) -> tuple[date, date]:
+    """Return inclusive start, exclusive end in exchange SESSION-LABEL dates."""
+    if timeframe == '1M':
+        start = day.replace(day=1)
+        return start, next_month(start)
+    if timeframe == '1W':
+        start = day - timedelta(days=day.weekday())
+        return start, start + timedelta(days=7)
+    if timeframe == '1D':
+        return day, day + timedelta(days=1)
+    raise ValueError('CALENDAR_PERIOD_REQUIRED')
+
+
+def period_bounds(inst, timeframe: str, day: date):
+    start, end = period_dates(day, timeframe)
+    if inst.calendar_id == '24/7_UTC':
+        return (datetime.combine(start, datetime.min.time(), UTC),
+                datetime.combine(end, datetime.min.time(), UTC), start.isoformat())
+    cal = exchange_calendar(inst.calendar_id, start.year)
+    sessions = cal.sessions_in_range(start.isoformat(), (end - timedelta(days=1)).isoformat())
+    if not len(sessions):
+        raise ValueError('EMPTY_CALENDAR_PERIOD')
+    return (cal.session_open(sessions[0]).to_pydatetime(),
+            cal.session_close(sessions[-1]).to_pydatetime(), start.isoformat())
+
+
+def utc_interval(at: datetime, timeframe: str):
+    if at.tzinfo is None or at.utcoffset() != timedelta(0):
+        raise ValueError('UTC_INTERVAL_TIME_REQUIRED')
+    if at.minute or at.second or at.microsecond:
+        raise ValueError('NATIVE_BAR_ALIGNMENT_MISMATCH')
+    if timeframe == '1M':
+        if at.day != 1 or at.hour:
+            raise ValueError('NATIVE_MONTH_ALIGNMENT_MISMATCH')
+        return at, datetime.combine(next_month(at.date()), datetime.min.time(), UTC), at.date().isoformat()
+    if timeframe not in HOURS:
+        raise ValueError('UNSUPPORTED_BAR_INTERVAL')
+    hours = HOURS[timeframe]
+    if (timeframe in {'1D', '1W'} and at.hour) or (timeframe in {'4H', '12H'} and at.hour % hours):
+        raise ValueError('NATIVE_BAR_ALIGNMENT_MISMATCH')
+    if timeframe == '1W' and at.weekday() != 0:
+        raise ValueError('NATIVE_WEEK_ALIGNMENT_MISMATCH')
+    return at, at + timedelta(hours=hours), at.date().isoformat()
+
+
+def native_period_interval(at: datetime, timeframe: str, inst, profile: dict):
+    """Accept only an explicit, matching chart period timestamp representation.
+
+    Weekly UTC-period-start is the legacy convention; a new exchange monthly
+    path must be configured, not guessed from its ticker.
+    """
+    modes = profile.get('period_timestamp_modes', {})
+    mode = modes.get(timeframe, 'UTC_PERIOD_START' if timeframe == '1W' else None)
+    if mode not in {'UTC_PERIOD_START', 'FIRST_SESSION_DATE', 'SESSION_OPEN'}:
+        raise ValueError('PERIOD_TIMESTAMP_MODE_REQUIRED:' + timeframe)
+    # A futures session can open in the previous month. Search neighboring
+    # session-label periods, then require a unique EXACT timestamp match.
+    candidate_days = {at.date(), at.date() + timedelta(days=2), at.date() - timedelta(days=2)}
+    matches = {}
+    for day in candidate_days:
+        start, end = period_dates(day, timeframe)
+        try:
+            opened, closed, label = period_bounds(inst, timeframe, start)
+        except ValueError as exc:
+            if str(exc) == 'EMPTY_CALENDAR_PERIOD':
+                continue
+            raise
+        cal = exchange_calendar(inst.calendar_id, start.year)
+        sessions = cal.sessions_in_range(start.isoformat(), (end - timedelta(days=1)).isoformat())
+        if mode == 'UTC_PERIOD_START':
+            expected = datetime.combine(start, datetime.min.time(), UTC)
+        elif mode == 'FIRST_SESSION_DATE':
+            expected = datetime.combine(sessions[0].date(), datetime.min.time(), UTC)
+        else:
+            expected = opened
+        if at == expected:
+            matches[label] = opened, closed, label
+    if len(matches) != 1:
+        raise ValueError('NATIVE_PERIOD_TIMESTAMP_UNRESOLVED:' + timeframe)
+    return next(iter(matches.values()))
+
+
+def latest_period_close(inst, timeframe: str, now: datetime):
+    """Last complete exchange/calendar period; not the last session SO FAR."""
+    from zoneinfo import ZoneInfo
+    day = now.date() if inst.calendar_id == '24/7_UTC' else now.astimezone(ZoneInfo(inst.timezone)).date()
+    closes = []
+    # A bounded scan of whole periods handles holidays, long closures, year
+    # boundaries and overnight sessions without truncating the final group.
+    start, _ = period_dates(day + timedelta(days=2), timeframe)
+    for _ in range(8):
+        try:
+            _, closed, _ = period_bounds(inst, timeframe, start)
+            if closed <= now:
+                closes.append(closed)
+        except ValueError as exc:
+            if str(exc) != 'EMPTY_CALENDAR_PERIOD':
+                raise
+        start, _ = period_dates(start - timedelta(days=1), timeframe)
+    return max(closes).isoformat() if closes else None
