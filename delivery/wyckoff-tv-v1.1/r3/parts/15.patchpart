+class CalendarBoundaryTests(unittest.TestCase):
+    def test_saturday_not_weekly_due(self):
+        self.assertEqual(periods('2026-09-07T00:00:00Z','2026-09-12T23:59:59Z','UTC'),[])
+    def test_leap_month_is_calendar_month(self):
+        p=periods('2024-02-01T00:00:00Z','2024-03-01T00:00:00Z','UTC')
+        month=next(v for v in p if v['kind']=='MONTH')
+        self.assertEqual(month['end'],'2024-03-01T00:00:00+00:00')
+    def test_december_rollover(self):
+        p=periods('2025-12-25T00:00:00Z','2026-01-01T00:00:00Z','UTC')
+        self.assertTrue(any(v['id']=='month-2025-12' for v in p))
+    def test_dst_week_not_hardcoded_168_hours(self):
+        p=periods('2026-03-02T00:00:00-05:00','2026-03-09T00:00:00-04:00','America/New_York')
+        week=next(v for v in p if v['kind']=='WEEK')
+        a=datetime.fromisoformat(week['start']);b=datetime.fromisoformat(week['end'])
+        self.assertEqual((b-a).total_seconds(),167*3600)
+    def test_timezone_changes_actual_sunday_boundary(self):
+        self.assertEqual(periods('2026-09-07T00:00:00Z','2026-09-12T16:00:00Z','UTC'),[])
+        self.assertTrue(periods('2026-09-07T00:00:00Z','2026-09-12T16:00:00Z','Asia/Shanghai'))
+
+
+class IntegrationTests(unittest.TestCase):
+    def config(self):
+        cfg=template();cfg.update(enabled=True,write_tv=True,products=[product()],min_daily_bars=10,min_weekly_bars=3)
+        return cfg
+    def test_shared_layout_requires_explicit_same_product_mode(self):
+        cfg=self.config();p=cfg['products'][0];p['analysis_timeframes']=['1D','4H'];p['delivery_layouts']={'1D':'SYNTH_LAYOUT','4H':'SYNTH_LAYOUT'}
+        with self.assertRaises(ValueError):validate_config(cfg)
+        p['layout_mode']='SEQUENTIAL_SAME_PRODUCT';validate_config(cfg)
+        self.assertEqual([u['layout_id'] for u in tracks(p)],['SYNTH_LAYOUT','SYNTH_LAYOUT'])
+    def test_journal_hook_runs_on_no_new_candles(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            cfg=self.config();cfg['write_tv']=False;clock=Clock()
+            run_once(Path(tmp),cfg,engine=FakeEngine(),reviewer=FakeReviewer(),tv_factory=lambda p:FakeTV(),clock=clock)
+            with patch('global_market_intelligence.opportunities.native.pipeline.journal_checkpoint',return_value={'status':'SYNCED','reviews_created':0}) as hook:
+                result=run_once(Path(tmp),cfg,engine=FakeEngine(),reviewer=FakeReviewer(),tv_factory=lambda p:FakeTV(),clock=clock)
+                self.assertTrue(hook.called);self.assertEqual(result['journal']['status'],'SYNCED')
+    def test_journal_failure_does_not_repeat_market_analysis(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            cfg=self.config();cfg['write_tv']=False;clock=Clock()
+            with patch('global_market_intelligence.opportunities.native.pipeline.journal_checkpoint',return_value={'status':'FAILED','error':'disk'}):
+                r=run_once(Path(tmp),cfg,engine=FakeEngine(),reviewer=FakeReviewer(),tv_factory=lambda p:FakeTV(),clock=clock)
+            self.assertEqual(r['state'],'PARTIAL')
+            store=EventStore(Path(tmp)/'archive');n=len([e for e in store.events() if e['kind']=='NATIVE_RESEARCH'])
+            run_once(Path(tmp),cfg,engine=FakeEngine(),reviewer=FakeReviewer(),tv_factory=lambda p:FakeTV(),clock=clock)
+            self.assertEqual(n,len([e for e in store.events() if e['kind']=='NATIVE_RESEARCH']))
+
